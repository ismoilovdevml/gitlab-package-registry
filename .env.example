# Copy to .env (docker compose) or .env.local (pnpm dev) and fill in.

# Public URL users open Ombor at. The GitLab OAuth redirect URI is ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts sessions, OAuth tokens and stored secrets — keep it stable.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# docker compose only
POSTGRES_PASSWORD=

# pnpm dev only (docker compose builds this from POSTGRES_PASSWORD)
DATABASE_URL=postgresql://ombor:password@localhost:5432/ombor

# Optional
# COOKIE_SECURE=true            # force Secure cookies (default: true when NODE_ENV=production)
# CLEANUP_INTERVAL_MINUTES=1440 # how often scheduled cleanup policies run
# NODE_EXTRA_CA_CERTS=/certs/ca.crt  # trust a self-signed GitLab CA
